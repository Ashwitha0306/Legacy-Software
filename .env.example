# ============================================================
# Root .env — copy to .env and fill in your values
# ============================================================

# ---- Backend (Node.js / Express) ----
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret_string_32+chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legacy_intel?retryWrites=true&w=majority

# ---- Analysis Service (Python / FastAPI) ----
ANALYSIS_SERVICE_URL=http://localhost:8000
ANALYSIS_SERVICE_SECRET=replace_with_a_shared_secret_for_internal_calls

# ---- LLM (Ollama — local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- File Storage ----
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=500

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Confidence Score Weights (RAV formula) ----
CONFIDENCE_ALPHA=0.5
CONFIDENCE_BETA=0.3
CONFIDENCE_GAMMA=0.2

# ---- Architecture Health Score Weights ----
HEALTH_W1=0.20
HEALTH_W2=0.15
HEALTH_W3=0.15
HEALTH_W4=0.15
HEALTH_W5=0.15
HEALTH_W6=0.20
